{
  "subscriptionCode": "<SUBSCRIPTION_CODE>",
  "credentials": {
    "tokenEndpoint": "https://ycloud.accounts.ondemand.com/oauth2/token",
    "clientId": "<CLIENT_ID>",
    "clientSecret": "<CLIENT_SECRET>",
    "clientResource": "urn:sap:identity:application:provider:name:cp-dependency",
    "clientExpires": "<DD/MM/YYYY hh:mm:ss AM/PM>"
  },
  "certificates": {
    "2026": {
      "directory": "2026",
      "certificate": "certificate.pem",
      "privateKey": "private-key.pem",
      "caChain": "ca-chain.pem"
    },
    "2027": {
      "directory": "2027",
      "certificate": "certificate.pem",
      "privateKey": "private-key.pem",
      "caChain": "ca-chain.pem"
    }
  },
  "environments": {
    "d1": {
      "description": "Development",
      "endpoints": {
        "jsapps": {
          "domain": "www.example.com",
          "certificate": "2026"
        },
        "backoffice":{
          "domain": "backoffice.example.com",
          "certificate": "2026"
        },
        "api":{
          "domain": "api.example.com",
          "certificate": "2026"
        },
        "processing":{
          "domain": "backgroundprocessing.example.com",
          "certificate": "2026"
        },
        "solr":{
          "domain": "solr.example.com",
          "certificate": "sap-managed"
        }
      }
    }
  },
  "cleanup": {
    "protectedCertificates": [
      "*-public - * (Let's Encrypt)",
      "<NAME_OR_CODE_OF_OTHER_CERTIFICATES>"
    ]
  }
}
