# SAP Commerce Cloud Management CLI - proprietary SAP software, download it yourself
# (the ZIP in tools/ is extracted automatically to tools/sapccm/)
tools/sapccm/
tools/*.zip
tools/*.ZIP

# Project data: configuration incl. the technical user's credentials, certificates and
# private keys - never commit (only the example configuration and the empty folder are versioned)
certtool.json
certificates/*
!certificates/.gitkeep
*.key
*-key.pem

# Python
__pycache__/
*.pyc

# OS / IDE
.DS_Store
.idea/
.vscode/
